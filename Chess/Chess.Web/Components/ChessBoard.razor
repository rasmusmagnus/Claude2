@using Events
@using Events.Commands
@using Events.Events
@using Chess.Web.Services
@using Chess.Core.Pieces
@using Chess.Shared
@implements IDisposable
@inject BoardStateStore Store
@inject IEventProducer<ICommand> Commands
@inject ILogger<ChessBoard> Logger

<div class="board-shell">
    <div class="check-status-slot">
        @if (!_isMate)
        {
            <div class="turn-status @(_movingColour == Colour.White ? "white" : "black")"
                 aria-live="polite">
                <span class="turn-dot" aria-hidden="true"></span>
                <span><strong>@_movingColour</strong> to move</span>
            </div>
        }
        @if (_isMate && Winner is { } winner)
        {
            <div class="game-result" role="alert">
                <span class="trophy" aria-hidden="true">🏆</span>
                <span>
                    <strong>Checkmate!</strong>
                    <small>@winner wins</small>
                </span>
            </div>
        }
        else if (_colourInCheck is { } colour)
        {
            <div class="check-status" role="alert">
                <span aria-hidden="true">⚠</span>
                <strong>@colour king is in check</strong>
            </div>
        }
    </div>

    <div class="board @(_movingColour == Colour.White ? "turn-white" : "turn-black") @(_isMate ? "game-over" : null) @(_promotion is not null ? "awaiting-promotion" : null)"
         role="grid"
         aria-label="@BoardAriaLabel">
    @for (var rank = 7; rank >= 0; rank--)
    {
        var r = rank;
        @for (var file = 0; file < 8; file++)
        {
            var f = file;
            var square = SquareName(f, r);
            var piece = _grid[r][f];
            var isDark = (f + r) % 2 == 0;

            <div class="square @(isDark ? "dark" : "light") @(IsCheckedKing(piece) ? (_isMate ? "in-check checkmated-king" : "in-check") : null) @(IsWinningKing(piece) ? "winning-king" : null)"
                 role="gridcell"
                 aria-label="@SquareLabel(square, piece)"
                 @key="square"
                 ondragenter="event.preventDefault()"
                 ondragover="event.preventDefault()"
                 @ondrop="() => OnDrop(square)">

                @if (f == 0)
                {
                    <span class="coord rank">@(r + 1)</span>
                }
                @if (r == 0)
                {
                    <span class="coord file">@((char)('a' + f))</span>
                }

                @if (piece != '\0')
                {
                    <span class="piece @(char.IsUpper(piece) ? "white" : "black")"
                          draggable="@(_isMate || _promotion is not null ? "false" : "true")"
                          @ondragstart="() => OnDragStart(square)"
                          aria-label="@PieceName(piece)">
                        @Glyph(piece)
                    </span>
                }
            </div>
        }
        }
        @if (_promotion is { } promotion)
        {
            <div class="promotion-picker @(promotion.Colour == Colour.White ? "white" : "black")"
                 style="@PromotionStyle(promotion)"
                 role="dialog"
                 aria-label="Choose a piece to promote the pawn on @promotion.Pos">
                <span class="promotion-prompt">Promote pawn</span>
                @foreach (var option in PromotionOptions)
                {
                    var promotionPiece = PromotionPiece(option, promotion.Colour);
                    <button type="button"
                            class="promotion-option"
                            disabled="@_promotionSubmitted"
                            title="Promote to @option"
                            aria-label="Promote pawn to @option"
                            @onclick="() => PromoteTo(option)">
                        <span class="piece @(promotion.Colour == Colour.White ? "white" : "black")" aria-hidden="true">
                            @Glyph(promotionPiece)
                        </span>
                    </button>
                }
            </div>
        }
    </div>
</div>

@code {
    private char[][] _grid = Fen.ToGrid(Fen.StartPosition);
    private string? _dragFrom;
    private Colour? _colourInCheck;
    private bool _isMate;
    private Colour _movingColour = Colour.White;
    private PromotingEvent? _promotion;
    private bool _promotionSubmitted;
    private static readonly PromoteOptions[] PromotionOptions =
        [PromoteOptions.Queen, PromoteOptions.Rook, PromoteOptions.Bishop, PromoteOptions.Knight];

    private Colour? Winner => !_isMate ? null : _colourInCheck switch
    {
        Colour.White => Colour.Black,
        Colour.Black => Colour.White,
        _ => null
    };

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        Refresh();
    }

    private void OnStoreChanged() => InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    private void Refresh()
    {
        var snapshot = Store.Snapshot;
        _grid = Fen.ToGrid(snapshot.Fen);
        _movingColour = MovingColourFromFen(snapshot.Fen);
        _colourInCheck = snapshot.ColourInCheck;
        _isMate = snapshot.IsMate;
        if (_promotion != snapshot.Promotion)
            _promotionSubmitted = false;
        _promotion = snapshot.Promotion;
    }

    private void OnDragStart(string square)
    {
        if (!_isMate && _promotion is null)
            _dragFrom = square;
    }

    private void OnDrop(string target)
    {
        var from = _dragFrom;
        _dragFrom = null;

        // Ignore no-op drops; the engine is the source of truth for everything else.
        if (_isMate || _promotion is not null || from is null || from == target)
            return;

        // Fire-and-forget intent. We do NOT move the piece here — the board only
        // changes when the core domain emits a BoardUpdateEvent. An unaccepted
        // (future: illegal) move produces no event, so the piece visibly stays put.
        var move = new Move(from.ToPosition(), target.ToPosition());
        Logger.LogInformation("Submitting move {Move}", move);
        Commands.SubmitEvent(new MakeMoveCommand(move));
    }

    private void PromoteTo(PromoteOptions option)
    {
        if (_promotion is null || _promotionSubmitted)
            return;

        _promotionSubmitted = true;
        Logger.LogInformation("Submitting promotion choice {Option}", option);
        Commands.SubmitEvent(new PromoteToCommand(option));
    }

    private static string PromotionStyle(PromotingEvent promotion)
    {
        var column = promotion.Pos.File - 'a' + 1;
        return $"--promotion-column: {column};";
    }

    private static char PromotionPiece(PromoteOptions option, Colour colour)
    {
        var piece = option switch
        {
            PromoteOptions.Queen => 'q',
            PromoteOptions.Rook => 'r',
            PromoteOptions.Bishop => 'b',
            PromoteOptions.Knight => 'n',
            _ => throw new ArgumentOutOfRangeException(nameof(option), option, null)
        };
        return colour == Colour.White ? char.ToUpperInvariant(piece) : piece;
    }

    private static string SquareName(int file, int rank) => $"{(char)('a' + file)}{rank + 1}";

    private string BoardAriaLabel => _isMate && Winner is { } winningColour
        ? $"Chess board. Checkmate. {winningColour} wins."
        : $"Chess board. {_movingColour} to move.";

    private static Colour MovingColourFromFen(string fen)
    {
        var fields = fen.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return fields.Length > 1 && fields[1].Equals("b", StringComparison.OrdinalIgnoreCase)
            ? Colour.Black
            : Colour.White;
    }

    private bool IsCheckedKing(char piece) => _colourInCheck switch
    {
        Colour.White => piece == 'K',
        Colour.Black => piece == 'k',
        _ => false
    };

    private bool IsWinningKing(char piece) => Winner switch
    {
        Colour.White => piece == 'K',
        Colour.Black => piece == 'k',
        _ => false
    };

    private string SquareLabel(string square, char piece)
    {
        if (IsWinningKing(piece))
            return $"{square}, {PieceName(piece)}, winner";
        if (IsCheckedKing(piece))
            return $"{square}, {PieceName(piece)}, {(_isMate ? "checkmated" : "in check")}";
        return square;
    }

    private static string Glyph(char piece) => char.ToLowerInvariant(piece) switch
    {
        'k' => "♚",
        'q' => "♛",
        'r' => "♜",
        'b' => "♝",
        'n' => "♞",
        'p' => "♟",
        _ => ""
    };

    private static string PieceName(char piece)
    {
        var colour = char.IsUpper(piece) ? "White" : "Black";
        var kind = char.ToLowerInvariant(piece) switch
        {
            'k' => "king",
            'q' => "queen",
            'r' => "rook",
            'b' => "bishop",
            'n' => "knight",
            'p' => "pawn",
            _ => "piece"
        };
        return $"{colour} {kind}";
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
