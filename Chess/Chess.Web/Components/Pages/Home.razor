@page "/"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Events
@using Events.Commands
@using Chess.Web.Services
@implements IDisposable
@inject BoardStateStore Store
@inject IEventProducer<ICommand> Commands

<PageTitle>Chess</PageTitle>

<div class="game">
    <ChessBoard />

    <aside class="panel">
        <h1>Chess</h1>
        <p class="hint">Drag a piece to submit a move. The board only updates when
            the core domain accepts the move and emits a board-update event — this
            UI never applies moves itself.</p>

        <div class="controls">
            <button class="btn" @onclick="NewGame">New game</button>
            <button class="btn" @onclick="Flush">Flush state</button>
        </div>

        <form class="fen-seed" @onsubmit="StartFromFen" @onsubmit:preventDefault>
            <label for="fen-input">Start from FEN</label>
            <p class="hint">Paste a complete six-field position to begin a new game from it.</p>
            <textarea id="fen-input" class="fen-input" rows="3" @bind="_seedFen"
                      aria-describedby="fen-help" aria-invalid="@(_fenError is not null)"></textarea>
            @if (_fenError is not null)
            {
                <p id="fen-help" class="fen-error" role="alert">@_fenError</p>
            }
            else
            {
                <span id="fen-help" class="visually-hidden">Enter all six FEN fields.</span>
            }
            <button class="btn" type="submit">Load position</button>
        </form>

        <h2>Exported state</h2>
        <p class="hint">Copy this into a <code>[Theory]</code> to seed a unit test.
            It is also written to the server console.</p>
        <textarea class="export" readonly rows="6"
                  placeholder="Press &quot;Flush state&quot; to capture the current board history…">@_export</textarea>

        <h2>Board history <span class="count">(@_history.Count)</span></h2>
        <ol class="history">
            @for (var i = _history.Count - 1; i >= 0; i--)
            {
                <li><code>@_history[i]</code></li>
            }
        </ol>
        @if (_history.Count == 0)
        {
            <p class="empty">No board-update events received yet.</p>
        }
    </aside>
</div>

@code {
    private IReadOnlyList<string> _history = System.Array.Empty<string>();
    private string _export = "";
    private string _seedFen = Fen.StartPosition;
    private string? _fenError;

    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        _history = Store.History;
    }

    private void OnStoreChanged() => InvokeAsync(() =>
    {
        _history = Store.History;
        StateHasChanged();
    });

    // The UI submits intentions; the engine remains responsible for changing state.
    private void NewGame()
    {
        _fenError = null;
        Commands.SubmitEvent(new NewGameCommand());
    }

    private void StartFromFen()
    {
        if (!Fen.TryNormalize(_seedFen, out var normalized, out var error))
        {
            _fenError = error;
            return;
        }

        _fenError = null;
        _seedFen = normalized;
        Commands.SubmitEvent(new StartFromFenCommand(normalized));
    }

    // Export the state observed from engine events for test authoring.
    private void Flush() => _export = Store.Flush();

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
